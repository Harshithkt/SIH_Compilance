# Copy to backend/.env and fill in. Never commit the real key.

# Nebius Token Factory (OpenAI-compatible API)
NEBIUS_API_KEY=

# Optional overrides
# LABELLENS_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# LABELLENS_NEBIUS_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
