# Copy to backend/.env and fill in. Never commit the real key.

# Nebius Token Factory (OpenAI-compatible API)
NEBIUS_API_KEY=

# Optional overrides
# LABELLENS_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# LABELLENS_NEBIUS_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# LABELLENS_NEBIUS_TEXT_MODEL=meta-llama/Llama-3.3-70B-Instruct
# LABELLENS_OCR_PROVIDER=auto          # auto | nebius | tesseract | manual
# LABELLENS_ACTIVE_RULE_VERSION=2011-v1
# LABELLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LABELLENS_CORS_ORIGIN_REGEX=https://.*\.vercel\.app
#
# Deploying (see docs/DEPLOY.md):
# LABELLENS_CORS_ORIGINS=https://your-app.vercel.app
# LABELLENS_DATABASE_URL=sqlite:////app/storage/labellens.db   # onto a mounted persistent disk
