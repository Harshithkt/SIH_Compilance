# Copy to frontend/.env.local for local dev against a non-default backend.
# In Vercel, set this in Project Settings -> Environment Variables instead —
# never commit a real deployment URL here.

# Base URL of the deployed backend, no trailing slash (e.g. Render's service URL).
# Left unset, the app calls a same-origin /api/v1/... (what the Vite dev proxy and the
# Docker/nginx setup both rely on) — only needed when the frontend and backend are on
# different origins, as with Vercel + Render.
VITE_API_URL=https://your-backend.onrender.com
